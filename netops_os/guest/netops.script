Window.SetBackgroundTopColor(0.0, 0.0, 0.0);
Window.SetBackgroundBottomColor(0.0, 0.0, 0.0);

logo.image = Image("netops-splash.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX((Window.GetWidth() - logo.image.GetWidth()) / 2);
logo.sprite.SetY((Window.GetHeight() - logo.image.GetHeight()) / 2);

# Plymouth supplies the real boot progress (0.0..1.0). Keep the screen
# usable on themes that do not emit progress by showing 0% until the first
# callback arrives.
progress.image = Image.Text("0%", 0.55, 0.75, 1.0);
progress.sprite = Sprite(progress.image);
progress.sprite.SetX((Window.GetWidth() - progress.image.GetWidth()) / 2);
progress.sprite.SetY(Window.GetHeight() * 0.86);

fun update_progress(duration, value) {
    percentage = Math.Int(value * 100);
    if (percentage < 0) { percentage = 0; }
    if (percentage > 100) { percentage = 100; }
    progress.image = Image.Text(percentage + "%", 0.55, 0.75, 1.0);
    progress.sprite.SetImage(progress.image);
    progress.sprite.SetX((Window.GetWidth() - progress.image.GetWidth()) / 2);
}

Plymouth.SetBootProgressFunction(update_progress);
