d-i debian-installer/locale string en_US.UTF-8
d-i keyboard-configuration/xkb-keymap select tr
d-i netcfg/choose_interface select auto
d-i netcfg/get_hostname string netops-os
d-i netcfg/get_domain string local
d-i mirror/country string manual
d-i mirror/http/hostname string deb.debian.org
d-i mirror/http/directory string /debian
d-i mirror/suite string bookworm
d-i mirror/udeb/suite string bookworm
d-i mirror/http/proxy string
d-i clock-setup/utc boolean true
d-i time/zone string Europe/Istanbul
d-i partman-auto/method string regular
d-i partman-auto/choose_recipe select atomic
d-i partman/confirm_write_new_label boolean true
d-i partman/choose_partition select finish
d-i partman/confirm boolean true
d-i partman/confirm_nooverwrite boolean true
d-i passwd/root-login boolean false
d-i passwd/user-fullname string NetOps Owner
d-i passwd/username string netops
d-i passwd/user-password-crypted password __NETOPS_PASSWORD_HASH__
d-i user-setup/allow-password-weak boolean false
tasksel tasksel/first multiselect standard, xfce-desktop
d-i pkgsel/include string python3 python3-tk python3-pil.imagetk lightdm plymouth plymouth-themes desktop-base xfce4-whiskermenu-plugin xfce4-pulseaudio-plugin xfce4-clipman-plugin greybird-gtk-theme elementary-xfce-icon-theme wget ca-certificates
d-i pkgsel/upgrade select none
d-i debian-installer/allow_unauthenticated boolean false
d-i grub-installer/only_debian boolean true
d-i grub-installer/with_other_os boolean true
d-i grub-installer/bootdev string /dev/vda
d-i finish-install/reboot_in_progress note
d-i preseed/late_command string in-target /bin/sh -c "wget -q -O /tmp/netops-payload.tar.gz http://10.0.2.2:8000/netops-payload.tar.gz; mkdir -p /tmp/netops-payload; tar -xzf /tmp/netops-payload.tar.gz -C /tmp/netops-payload; /bin/sh /tmp/netops-payload/install-netops-preview.sh; mkdir -p /etc/lightdm/lightdm.conf.d; printf '[Seat:*]\\nautologin-user=netops\\nautologin-user-timeout=0\\nautologin-session=netops\\nuser-session=netops\\n' > /etc/lightdm/lightdm.conf.d/50-netops.conf"
